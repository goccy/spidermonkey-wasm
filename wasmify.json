{
  "version": "1.0",
  "upstream": {
    "path": "./starlingmonkey",
    "commit": "5c671dd86db596ac2ea88a60bebf8d4505b4b8fa",
    "branch": "main"
  },
  "project": {
    "name": "spidermonkey",
    "root_dir": "./starlingmonkey",
    "language": "cpp",
    "language_standard": "c++20"
  },
  "build_system": {
    "type": "other",
    "files": [
      "starlingmonkey/cmake/spidermonkey.cmake",
      "starlingmonkey/cmake/build-crates.cmake"
    ]
  },
  "targets": [
    {
      "name": "spidermonkey",
      "type": "library",
      "build_target": "libspidermonkey.a",
      "description": "SpiderMonkey (Firefox 147) built for wasm32-wasi with --disable-jit --enable-portable-baseline-interp. Published prebuilt by the StarlingMonkey project and downloaded by scripts/fetch-spidermonkey.sh; there is no source tree for wasmify to capture and replay, so build.json has no steps and the archive reaches the link through wasm_build.prebuilt_archives."
    }
  ],
  "dependencies": [
    {
      "name": "wasi-sdk",
      "type": "tool",
      "required": true
    },
    {
      "name": "rust",
      "type": "tool",
      "required": true
    }
  ],
  "required_tools": [
    {
      "name": "cargo",
      "installed": false,
      "detect_cmd": "cargo --version",
      "install": {
        "darwin": {
          "commands": [
            "brew install rustup",
            "rustup toolchain install 1.88.0 --profile minimal --target wasm32-wasip1"
          ]
        },
        "debian": {
          "commands": [
            "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0 --target wasm32-wasip1"
          ]
        }
      }
    }
  ],
  "build_commands": {
    "configure": "bash scripts/fetch-spidermonkey.sh",
    "build": "bash scripts/build-rust-crates.sh"
  },
  "output": {
    "wasm": "build/spidermonkey.wasm"
  },
  "user_selection": {
    "target_name": "spidermonkey",
    "build_type": "library"
  },
  "bridge": {
    "CustomBridgeSources": [
      "js.cc",
      "starlingmonkey/crates/rust-hooks/src/wrappers.cpp"
    ],
    "GoPackage": "github.com/goccy/go-spidermonkey/internal;internal",
    "Wasm2GoImportPath": "github.com/goccy/spidermonkeywasm2go",
    "HostThreads": true,
    "MaxMemoryPages": 4096,
    "StackSize": 8388608,
    "ExportFunctions": [
      "js_new",
      "js_eval",
      "js_agent_spawn",
      "js_agent_wake",
      "js_clone_write",
      "js_clone_read",
      "js_clone_free",
      "js_gc",
      "js_detach_array_buffer",
      "js_new_realm",
      "js_eval_in",
      "js_new_htmldda",
      "js_eval_module",
      "js_global",
      "js_new_plain_object",
      "js_define_function",
      "js_define_constructor",
      "js_free_object",
      "js_get",
      "js_set",
      "js_call",
      "js_new_function",
      "js_construct",
      "js_bytes_new",
      "js_bytes_read",
      "js_close",
      "js_interrupt_addr",
      "js_interrupt_bits_addr",
      "js_interrupt_bits_value",
      "js_run_jobs"
    ]
  },
  "wasm_build": {
    "prebuilt_archives": [
      "deps/spidermonkey/libspidermonkey.a",
      "deps/spidermonkey/libjsrust.a"
    ],
    "extra_cxxflags": [
      "-std=gnu++20",
      "-fno-rtti",
      "-fno-exceptions",
      "-fno-sized-deallocation",
      "-fno-aligned-new",
      "-Wno-invalid-offsetof",
      "-Wno-unknown-warning-option",
      "-Wno-unused-result",
      "-DSPIDERMONKEY_WASM_THREADS",
      "-matomics",
      "-mbulk-memory"
    ],
    "bridge_extra_includes": [
      "deps/spidermonkey/include"
    ],
    "extra_ldflags": [
      "-Wl,--stack-first",
      "-lwasi-emulated-getpid"
    ]
  },
  "phases": {
    "gen-proto": {
      "completed_at": "2026-07-21T06:45:06Z",
      "upstream_commit": "5c671dd86db596ac2ea88a60bebf8d4505b4b8fa",
      "output_files": [
        "proto/spidermonkey.proto",
        "proto/wasmify/options.proto",
        "bridge/api_bridge.cc",
        "bridge/api_bridge.h"
      ]
    },
    "parse-headers": {
      "completed_at": "2026-07-21T06:45:05Z",
      "upstream_commit": "5c671dd86db596ac2ea88a60bebf8d4505b4b8fa",
      "output_files": [
        "api-spec.json"
      ]
    }
  }
}
