# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Local agent state
.claude/

# SpiderMonkey artifacts fetched by scripts/fetch-spidermonkey.sh (~520 MB).
deps/

# Cargo build tree for the Rust staticlib (rust/Cargo.lock IS committed).
rust/target/

# wasmify per-project build cache (.o / .a / cache.json) and smoke intermediates
.wasmify/

# wasmify-generated artefacts (regenerated by `make wasm` from wasmify.json +
# js.h/js.cc + the committed build.json). build.json itself IS committed: there
# is no native build to capture, so nothing regenerates it.
/api-spec.json
/proto/spidermonkey.proto
/bridge/
/build/
/*.wasm
